{
  "name": "wristcards",
  "author": "Eduardo Chiaro",
  "version": "1.0.0",
  "keywords": [
    "wristcards",
    "flashcards",
    "pebble",
    "watchapp",
    "language learning",
    "vocabulary",
    "dutch"
  ],
  "private": true,
  "scripts": {
    "build": "node scripts/inline-config.mjs && pebble clean && pebble build",
    "emulator": "node scripts/inline-config.mjs && pebble build && pebble install --emulator",
    "phone": "node scripts/inline-config.mjs && pebble build && pebble install --phone",
    "config": "pebble emu-app-config --emulator",
    "logs": "pebble logs",
    "check": "node scripts/check-groups.js",
    "packs": "python3 -m http.server 8000 --directory packs",
    "publish": "mkdir -p ../eduardochiaro.com-data/cdn/wristcards && cp packs/*.json packs/*.txt ../eduardochiaro.com-data/cdn/wristcards/",
    "screenshot": "./scripts/screenshot.sh"
  },
  "pebble": {
    "displayName": "Wristcards",
    "uuid": "f040c3c2-63de-420a-8abe-6ba52fe65ce6",
    "projectType": "moddable",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery",
      "gabbro"
    ],
    "watchapp": {
      "watchface": false
    },
    "capabilities": [
      "configurable"
    ],
    "messageKeys": [
      "hello",
      "ack",
      "oops",
      "want",
      "meta",
      "card",
      "done",
      "fail",
      "seq",
      "groups",
      "pick"
    ],
    "resources": {
      "media": [
        {
          "menuIcon": "true",
          "type": "png",
          "name": "MENU_ICON",
          "file": "menu_icon.png"
        }
      ]
    }
  }
}
